{
  "name": "x402-avm-js",
  "version": "0.3.0",
  "description": "x402 payments on Algorand (AVM) for browsers and Node: build, sign and encode exact-scheme payments on MainNet, TestNet and LocalNet.",
  "license": "MIT",
  "author": "AI Economy Team",
  "homepage": "https://x402-avm.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/x402-avm/x402-avm-js"
  },
  "bugs": {
    "url": "https://github.com/x402-avm/x402-avm-js/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "x402",
    "algorand",
    "avm",
    "payments",
    "usdc",
    "mcp",
    "402",
    "caip-2",
    "web3"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "algosdk": "^3.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  }
}
